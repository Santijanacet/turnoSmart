{
  "name": "turnosmart-api",
  "version": "1.0.0",
  "description": "TurnoSmart API - NestJS + PostgreSQL",
  "private": true,
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json --incremental false",
    "prebuild": "npm run clean && prisma generate",
    "start": "nest start --builder tsc",
    "prestart:dev": "npm run build",
    "start:dev": "nest start --watch --builder tsc",
    "start:debug": "nest start --debug --watch --builder tsc",
    "prestart:prod": "npm run build",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "module-alias": "^2.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.1.0",
    "rxjs": "^7.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.24",
    "@nestjs/testing": "^11.1.29",
    "@types/bcryptjs": "^2.4.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.0.0",
    "prisma": "^5.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
